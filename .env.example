# Copy to .env and fill in. .env is gitignored.

# Model key. With it, calls go straight to OpenAI (gpt-5.4-mini).
OPENAI_API_KEY=

# Supabase project (public values, also used by web/ through Vite).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# The one Supabase user the local agent and the web page both sign in as. The page logs in with it by itself.
AGENT_EMAIL=
AGENT_PASSWORD=

# Private link to the deployed page: https://<your-app>.vercel.app/?key=<ACCESS_KEY>. Any long random string.
# Set it in the Vercel project too: a Vercel build without it fails, so the page is never open to strangers.
ACCESS_KEY=
