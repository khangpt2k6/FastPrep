# Copy to .env and fill in. .env is gitignored.

# Model key. With it, calls go straight to OpenAI (gpt-5.4-mini).
OPENAI_API_KEY=

# Supabase project (public values, also used by web/ through Vite).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# The one Supabase user the local agent signs in as. You sign in to the web page with the same email and password;
# they are never built into the page, so do not set them in the Vercel project.
AGENT_EMAIL=
AGENT_PASSWORD=

# Optional: the inbox sync (agent-automation-inbox) reads this Gmail, read-only, for news of your applications.
# The password is a Google app password (https://myaccount.google.com/apppasswords), never the account's own.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
